  urldate = {2026-05-15},
  abstract = {This article develops the concept of wrongful depathologization, in which a psychiatric disorder is simultaneously stigmatized (because of sanist attitudes towards mental illness) and trivialized (as it is not considered a ``proper'' illness). We use OCD as a case study to argue that cumulatively these two effects generate a profound epistemic injustice to OCD sufferers, and possibly to those with other mental disorders. We show that even seemingly positive stereotypes attached to mental disorders give rise to both testimonial injustice and wilful hermeneutical ignorance. We thus expose an insidious form of epistemic harm that has been overlooked in the literature.},
