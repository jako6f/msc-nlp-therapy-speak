{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["annotations"],
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "annotation_id",
          "substantive_target_discourse",
          "clinical_frame_present",
          "lived_experience_frame_present",
          "confidence"
        ],
        "properties": {
          "annotation_id": {
            "type": "string",
            "minLength": 1
          },
          "substantive_target_discourse": {
            "type": "boolean"
          },
          "clinical_frame_present": {
            "type": ["boolean", "null"]
          },
          "lived_experience_frame_present": {
            "type": ["boolean", "null"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}

